# Copy to .env and fill in. EXPO_PUBLIC_ vars are inlined into the client bundle at
# build time, so nothing secret belongs here — the Supabase key below is the
# publishable one, which RLS is what actually protects.
#
# For local development against `npx supabase start`, use the values that command
# prints (API URL http://127.0.0.1:54321).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# The PowerSync instance endpoint, from the PowerSync Dashboard.
# Looks like https://<id>.powersync.journeyapps.com
EXPO_PUBLIC_POWERSYNC_URL=

# A TMDB v4 read access token (developer.themoviedb.org/reference/getting-started).
# Bundled client-side deliberately: it's read-only, rate-limited, and revocable, and this
# app has no backend to proxy it through — see the tmdb ADR-0003 comment in src/lib/tmdb.
EXPO_PUBLIC_TMDB_API_TOKEN=
